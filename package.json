{
  "name": "primebrew",
  "appName": "PrimeBrew",
  "version": "0.5.0",
  "description": "TizenBrew mod for Prime Video on Samsung Tizen TVs.",
  "packageType": "mods",
  "websiteURL": "https://www.primevideo.com",
  "main": "userScript.js",
  "serviceFile": "service.js",
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "MediaTrackNext",
    "MediaTrackPrevious"
  ],
  "files": ["userScript.js", "service.js"],
  "scripts": {
    "test": "node --check userScript.js && node --check service.js && node test.js"
  },
  "repository": {
    "url": "https://github.com/TheSmuks/primebrew"
  },
  "license": "MIT"
}
